ALLOWED_ORIGINS=https://safariticket-supabas-uoch.bolt.host
PII_ENCRYPTION_KEY=Xl7kNq4Vv3n2L8jP0bY5z1mGf9sR6cTwH8aDeUqJpK0=
TICKET_SIGNING_KEYS=K2:ACTIVE:3tYq9vL8Rk2Nw7HxP5mZc4FdJ1Qs6BaX9EuGv2Lp8Mn4Cr7Tw5
GATE_PROVISIONING_TOKEN=gate_Q7mLp2Xv9Rs4Hk8Nc5Tw1Za6Bj3Ef0Yu8Pd6Kv2Mx9Ln5Hr4
#!/usr/bin/env bash
set -euo pipefail

# Usage:
# 1) Create a file named .supabase-secrets.env in repo root (DO NOT commit it).
#    Example contents:
#    ALLOWED_ORIGINS=https://safariticket-supabas-uoch.bolt.host
PII_ENCRYPTION_KEY=Xl7kNq4Vv3n2L8jP0bY5z1mGf9sR6cTwH8aDeUqJpK0=
TICKET_SIGNING_KEYS=K2:ACTIVE:3tYq9vL8Rk2Nw7HxP5mZc4FdJ1Qs6BaX9EuGv2Lp8Mn4Cr7Tw5
GATE_PROVISIONING_TOKEN=gate_Q7mLp2Xv9Rs4Hk8Nc5Tw1Za6Bj3Ef0Yu8Pd6Kv2Mx9Ln5Hr4
# 2) Run: ./scripts/set-supabase-secrets.sh
#
# The script reads .supabase-secrets.env (or environment variables already set)
# and runs supabase secrets set for each variable.

if [ -f .supabase-secrets.env ]; then
  # shellcheck disable=SC1091
  set -o allexport
  # load file but avoid expansion surprises
  source .supabase-secrets.env
  set +o allexport
fi

: "${TICKET_SIGNING_KEYS:?TICKET_SIGNING_KEYS must be set (see .supabase-secrets.env)}"
: "${PII_ENCRYPTION_KEY:?PII_ENCRYPTION_KEY must be set}"
: "${GATE_PROVISIONING_TOKEN:?GATE_PROVISIONING_TOKEN must be set}"
: "${ALLOWED_ORIGINS:?ALLOWED_ORIGINS must be set}"

echo "Setting Supabase function secrets (you must be logged in with 'supabase login')"
supabase secrets set TICKET_SIGNING_KEYS="$TICKET_SIGNING_KEYS"
supabase secrets set PII_ENCRYPTION_KEY="$PII_ENCRYPTION_KEY"
supabase secrets set GATE_PROVISIONING_TOKEN="$GATE_PROVISIONING_TOKEN"
supabase secrets set ALLOWED_ORIGINS="$ALLOWED_ORIGINS"

echo "Done."
